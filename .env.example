# ========================================================
# Product Research Intelligence - Environment Configuration
# ========================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Product Research Intelligence"
API_V1_STR=/api/v1

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (Supabase PostgreSQL / Local Fallback)
# In Phase 2: configure Supabase project credentials.
DATABASE_URL=sqlite:///./data/product_intelligence.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
# SUPABASE_SERVICE_ROLE_KEY is used STRICTLY on the backend, NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# AI Provider Configuration (Phase 3+)
# Recommended initial provider: Google Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2

# Frontend Configuration (Vite environment variables prefix: VITE_)
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Product Research Intelligence"
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VITE_ENABLE_MOCK_FALLBACK=true
