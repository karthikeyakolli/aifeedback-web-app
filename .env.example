# =============================================================================
# Product Research Intelligence - Environment Configuration Template
# =============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Product Research Intelligence"
API_V1_STR=/api/v1

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
MAX_REQUEST_SIZE_BYTES=2097152

# Database & Supabase PostgreSQL Persistence
# Development fallback: sqlite:///./data/product_intelligence.db
# Canonical Production: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=sqlite:///./data/product_intelligence.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
# SUPABASE_SERVICE_ROLE_KEY is used STRICTLY on the backend, NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Authentication & JWT Configuration
# In production (ENVIRONMENT=production), 'supabase' auth is strictly required.
AUTH_PROVIDER=auto
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
SUPABASE_JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev-only-secret-key-change-in-prod-983172

# AI Provider Configuration (Phase 3 & 4 Analysis & Phase 5 Reports)
# Canonical provider: Google Gemini via official google-genai SDK, with OpenRouter free-tier, NVIDIA NIM, and Groq failover
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter Free Tier Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-placeholder
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FREE_ONLY=true
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME="AI Project Feedback Platform"

# NVIDIA NIM Configuration
NVIDIA_API_KEY=your-nvidia-api-key-placeholder
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=your-groq-api-key-placeholder
GROQ_MODEL=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=4096
MAX_ANALYSIS_COMMENTS=100
AI_COOLDOWN_SECONDS=30

# Frontend Configuration (Vite environment variables prefix: VITE_)
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Product Research Intelligence"
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VITE_ENABLE_MOCK_FALLBACK=false
